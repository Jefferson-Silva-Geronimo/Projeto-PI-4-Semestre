# Copie para .env e ajuste os valores

# Postgres (usado pelo docker-compose para criar o banco)
POSTGRES_USER=petshop
POSTGRES_PASSWORD=petshop
POSTGRES_DB=petshop

# Prisma — host "db" é o nome do serviço no docker-compose.
# Rodando o backend fora do Docker, troque "db" por "localhost".
DATABASE_URL=postgresql://petshop:petshop@localhost:5432/petshop?schema=public
DIRECT_URL=postgresql://petshop:petshop@localhost:5432/petshop?schema=public

# Segredo usado para assinar os tokens JWT
JWT_SECRET=troque-este-segredo